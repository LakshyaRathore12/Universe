rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Bootstrapped admin verification
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "lakshyar7512@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUniversityEvent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.clubId is string && data.clubId.size() <= 128
        && data.clubName is string && data.clubName.size() <= 150
        && data.category is string && data.category.size() <= 50
        && data.startDate is string && data.startDate.size() <= 30
        && data.status is string && (data.status == 'upcoming' || data.status == 'ongoing' || data.status == 'completed' || data.status == 'cancelled');
    }

    function isValidClub(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.category is string && data.category.size() <= 50
        && data.leadEmail is string && data.leadEmail.size() <= 150;
    }

    function isValidRegistration(data) {
      return data.eventId is string && data.eventId.size() <= 128
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100
        && data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() <= 150
        && data.ticketCode is string && data.ticketCode.size() <= 100
        && data.status is string && (data.status == 'confirmed' || data.status == 'checked_in' || data.status == 'cancelled');
    }

    function isValidCertificate(data) {
      return data.registrationId is string && data.registrationId.size() <= 128
        && data.eventId is string && data.eventId.size() <= 128
        && data.studentName is string && data.studentName.size() <= 100
        && data.studentEmail is string && data.studentEmail.size() <= 150;
    }

    function isValidDriveResource(data) {
      return data.fileId is string && data.fileId.size() > 0 && data.fileId.size() <= 200
        && data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && data.mimeType is string && data.mimeType.size() <= 150
        && data.webViewLink is string && data.webViewLink.size() <= 1000;
    }

    // --- EVENTS COLLECTION ---
    match /events/{eventId} {
      allow get, list: if true; // Public university event catalog
      allow create: if isSignedIn() && isValidId(eventId) && isValidUniversityEvent(incoming()) && (
        isAdmin() || incoming().createdBy == request.auth.uid
      );
      allow update: if isSignedIn() && isValidId(eventId) && isValidUniversityEvent(incoming()) && (
        isAdmin() || existing().createdBy == request.auth.uid
      );
      allow delete: if isSignedIn() && isValidId(eventId) && (
        isAdmin() || existing().createdBy == request.auth.uid
      );
    }

    // --- CLUBS COLLECTION ---
    match /clubs/{clubId} {
      allow get, list: if true; // Public campus clubs directory
      allow create: if isSignedIn() && isValidId(clubId) && isValidClub(incoming()) && (
        isAdmin() || incoming().leadEmail == request.auth.token.email
      );
      allow update: if isSignedIn() && isValidId(clubId) && isValidClub(incoming()) && (
        isAdmin() || existing().leadEmail == request.auth.token.email
      );
      allow delete: if isAdmin();
    }

    // --- REGISTRATIONS COLLECTION ---
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(registrationId) && isValidRegistration(incoming()) && (
        incoming().userId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && isValidId(registrationId) && isValidRegistration(incoming()) && (
        isAdmin() || existing().userId == request.auth.uid
      );
      allow delete: if isSignedIn() && isValidId(registrationId) && (
        isAdmin() || existing().userId == request.auth.uid
      );
    }

    // --- GOOGLE DRIVE RESOURCES COLLECTION ---
    match /drive_resources/{resourceId} {
      allow get, list: if true; // Public drive attachments and syllabus materials
      allow create: if isSignedIn() && isValidId(resourceId) && isValidDriveResource(incoming());
      allow update: if isSignedIn() && isValidId(resourceId) && isValidDriveResource(incoming()) && (
        isAdmin() || existing().ownerEmail == request.auth.token.email
      );
      allow delete: if isSignedIn() && isValidId(resourceId) && (
        isAdmin() || existing().ownerEmail == request.auth.token.email
      );
    }

    // --- CERTIFICATES COLLECTION ---
    match /certificates/{certificateId} {
      allow get: if true; // Public verification for certificate authenticity (QR scanning)
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(certificateId) && isValidCertificate(incoming()) && (
        isAdmin() || incoming().userId == request.auth.uid
      );
      allow update: if isSignedIn() && isValidId(certificateId) && isAdmin();
      allow delete: if isAdmin();
    }
  }
}
